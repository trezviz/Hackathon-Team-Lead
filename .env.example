# Copy this file to .env and fill in one real key. .env is gitignored.
# Set ONE of these (if both are set, ANTHROPIC_API_KEY is preferred unless AI_PROVIDER overrides it):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides:
# AI_PROVIDER=anthropic   # or: gemini — force a provider when both keys are set
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.5-flash
# PORT=8000
